# Copy these into your shell / IDE run configuration for local development.
# Spring Boot does not load this file automatically.
#
# PowerShell example:
#   $env:DB_URL="jdbc:postgresql://localhost:5432/shopsphere"
#   $env:DB_USERNAME="shopsphere"
#   $env:DB_PASSWORD="your-local-password"
#   $env:JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
#   .\mvnw.cmd spring-boot:run
#
# Bash example:
#   export DB_URL=jdbc:postgresql://localhost:5432/shopsphere
#   export DB_USERNAME=shopsphere
#   export DB_PASSWORD=your-local-password
#   export JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
#   ./mvnw spring-boot:run

DB_URL=jdbc:postgresql://localhost:5432/shopsphere
DB_USERNAME=shopsphere
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=https://shopsphere.local
JWT_EXPIRATION_MINUTES=60

# Optional. Leave unset for Vite proxy development.
# Example when SPA is on a different origin:
# CORS_ALLOWED_ORIGINS=http://localhost:5173
